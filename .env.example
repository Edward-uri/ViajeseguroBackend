NODE_ENV=development
PORT=3000

# Base de datos (RDS)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=true
# Máximo de conexiones del pool de pg (sube si la API recibe mucha carga). Default 10.
DB_POOL_MAX=10


JWT_SECRET=
JWT_EXPIRES_IN=7d

# Bcrypt
BCRYPT_ROUNDS=10

# Brevo (envío de OTP por correo). Sin esta key se usa el MockOtpSender (logs en consola).
BREVO_API_KEY=
EMAIL_FROM=noreply@codigoverse.space
EMAIL_FROM_NAME=Jala
# ID de la plantilla transaccional en Brevo (#1 "Jala Código de Verificación"). Usa params CODE y EXPIRY_MINUTES.
BREVO_TEMPLATE_ID=1

# Storage de documentos. En prod = punto de montaje del volumen persistente de Coolify (ej. /app/uploads).
# Vacío = <cwd>/uploads (dev local).
UPLOADS_DIR=

# Tiempo real / Push
SOCKET_CORS_ORIGIN=*
# JSON del service account de Firebase en base64 (vacío = push en modo log)
FCM_SERVICE_ACCOUNT=

# Ruteo real (OSRM self-hosted, red interna). Vacío = se usa solo Haversine (línea recta).
OSRM_URL=

# Plantilla de invitación de admins en Brevo. Usa params ACCEPT_URL, EXPIRY_DAYS, INVITER_EMAIL.
BREVO_INVITE_TEMPLATE_ID=
# Base del panel admin para construir el link de aceptación (.../aceptar-invitacion?token=...).
ADMIN_PANEL_URL=http://localhost:5173
# Días de vigencia del token de invitación. Default 7.
INVITE_TTL_DAYS=7
