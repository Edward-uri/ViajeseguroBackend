NODE_ENV=development
PORT=3000

# Base de datos (RDS)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=true


JWT_SECRET=
JWT_EXPIRES_IN=7d

# Bcrypt
BCRYPT_ROUNDS=10

# Brevo (envío de OTP por correo). Sin esta key se usa el MockOtpSender (logs en consola).
BREVO_API_KEY=
EMAIL_FROM=noreply@codigoverse.space
EMAIL_FROM_NAME=ViajeSeguro
